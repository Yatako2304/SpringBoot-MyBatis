<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.bennu.project.mapper.ExampleMapper">

    <resultMap id="exampleMap" type="com.bennu.project.model.Example">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="code" column="code"/>
        <result property="date" column="date"/>
        <result property="description" column="description"/>
        <result property="dateTime" column="date_time"/>
        <result property="active" column="active"/>
    </resultMap>

    <sql id="sqlExample">
        <!-- @formatter:off -->
        SELECT
            e.id
            , e.name
            , e.code
            , e.description
            , e.date
            , e.date_time
            , e.active
        FROM example e
        <!-- @formatter:on -->
    </sql>

    <select id="getAll" resultMap="exampleMap">
        <include refid="sqlExample"/>
    </select>

    <select id="get" resultMap="exampleMap" parameterType="java.lang.Long">
        <include refid="sqlExample"/>
        WHERE e.id = #{id}
    </select>

    <insert id="insert" parameterType="com.bennu.project.model.Example" keyProperty="id" useGeneratedKeys="true">
        <!-- @formatter:off -->
        INSERT INTO example (
            name
            , code
            , description
            , date
            , date_time
            , active
        ) VALUES (
            #{name}
            , #{code}
            , #{description}
            , #{date}
            , #{dateTime}
            , #{active}
        )
        <!-- @formatter:on -->
    </insert>

    <update id="update" parameterType="com.bennu.project.model.Example">
        <!-- @formatter:off -->
        UPDATE example SET
            name = #{name}
            , code = #{code}
            , description = #{description}
            , date = #{date}
            , date_time = #{dateTime}
            , active = #{active}
        WHERE id = #{id}
        <!-- @formatter:on -->
    </update>

    <delete id="deleteById">
        DELETE FROM example WHERE id = #{id}
    </delete>

</mapper>